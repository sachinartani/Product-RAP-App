managed implementation in class zsac_cl_bp_product unique;
strict ( 2 );
//with draft;

define behavior for ZSAC_R_Product alias Product
persistent table zsac_t_product
//draft table zsac_t_prod_d
lock master // total etag LastChangeDat
authorization master ( instance )
etag master LocalLastChangedAt
{
  create ( authorization : global, precheck );
  update ( features : instance );
  delete;

//  draft action Edit;
//  draft action Resume;
//  draft action Activate optimized;
//  draft action Discard;
//  draft determine action Prepare
//  {
//    validation ProductValuation~validateStocks;
//  }

  action ResetMaterial result [1] $self;
  static factory action ( authorization : global, precheck ) CreateProduct parameter ZSAC_A_PRODUCT [1];

  determination setSomeValues on modify { field IndustrySector; }

  //  side effects { field IndustrySector affects field UnitOfMeasure, field CurrencyCode; }

  field ( numbering : managed, readonly ) ProductUuid;

  field ( features : instance ) UnitOfMeasure, CurrencyCode;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  field ( readonly : update ) ProductId;

    association _ProductText { create; }
    association _ProductValuation { create; }
//  association _ProductText { create; with draft; }
//  association _ProductValuation { create; with draft; }

  mapping for zsac_t_product
    {
      ProductUuid        = product_uuid;
      ProductId          = product_id;
      MaterialType       = material_type;
      IndustrySector     = industry_sector;
      MaterialGroup      = material_group;
      UnitOfMeasure      = unit_of_measure;
      CurrencyCode       = currency_code;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for zsac_i_product_text alias ProductText
persistent table zsac_t_prod_txt
//draft table zsac_t_prodtxt_d
lock dependent by _Product
authorization dependent by _Product
{
  update;
  delete;
  field ( readonly, numbering : managed ) ProdTxtUuid;

  field ( readonly ) ProductUuid, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

    association _Product;
//  association _Product { with draft; }

  mapping for zsac_t_prod_txt
    {
      ProdTxtUuid        = prod_txt_uuid;
      ProductUuid        = product_uuid;
      Language           = language;
      Description        = description;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }

}

define behavior for zsac_i_product_valuation alias ProductValuation
persistent table zsac_t_prod_val
//draft table zsac_t_prodval_d
lock dependent by _Product
authorization dependent by _Product
{
  update;
  delete;

  action AddStocks result [1] $self;

  field ( readonly, numbering : managed ) ProdValUuid;

  field ( readonly ) ProductUuid, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  validation validateStocks on save { field TotalQuantity; create; update; }

    association _Product;
//  association _Product { with draft; }

  mapping for zsac_t_prod_val
    {
      ProdValUuid        = prod_val_uuid;
      ProductUuid        = product_uuid;
      ValuationType      = valuation_type;
      TotalQuantity      = total_quantity;
      StandardPrice      = standard_price;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LastChangedBy      = last_changed_by;
      LastChangedAt      = last_changed_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}