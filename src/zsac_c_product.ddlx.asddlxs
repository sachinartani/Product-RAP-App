@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Product',
    typeNamePlural: 'Products',
    title: { type: #STANDARD, value: 'ProductId' }, // The value attribute is case sensitive and must match the field name
    description: { value: 'MaterialType' }
  }
}
annotate entity zsac_c_product with
{
  @UI.facet: [
      {
          id:              'Identification',
          purpose:         #STANDARD,
          type:            #IDENTIFICATION_REFERENCE,
          label:           'Product Details',
          position:        10
      },
      {
          id:            'ProductText',
          purpose:       #STANDARD,
          type:          #LINEITEM_REFERENCE,
          label:         'Product Description',
          position:      20,
          targetElement: '_ProductText'
      },
      {
          id:            'ProductValuation',
          purpose:       #STANDARD,
          type:          #LINEITEM_REFERENCE,
          label:         'Product Valuation',
          position:      30,
          targetElement: '_ProductValuation'
      }
  ]

  @UI.hidden: true
  ProductUuid;

  @UI: { lineItem:       [ { position: 10, label: 'Product ID' },
                           { type: #FOR_ACTION, dataAction: 'ResetMaterial', label: 'Reset Product', position: 10 },
                           { type: #FOR_ACTION, dataAction: 'CreateProduct', label: 'Create Product', position: 20 } ],
         identification: [ { position: 10, label: 'Product ID' },
                           { type: #FOR_ACTION, dataAction: 'ResetMaterial', label: 'Reset Product', position: 10 } ],
         selectionField: [ { position: 10 } ] }
  ProductId;

  @UI: { lineItem:       [ { position: 20, label: 'Material Type' } ],
         identification: [ { position: 20, label: 'Material Type' } ],
         selectionField: [ { position: 20 } ] }
  MaterialType;

  @UI: { lineItem:       [ { position: 30, label: 'Industry' } ],
         identification: [ { position: 30, label: 'Industry' } ] }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZSAC_I_INDUSTRYVH', element: 'Industry' } }]
  @UI.textArrangement: #TEXT_FIRST
  IndustrySector;

  @UI: { lineItem:       [ { position: 40, label: 'Material Group' } ],
         identification: [ { position: 40, label: 'Material Group' } ] }
  MaterialGroup;

  @UI: { lineItem:       [ { position: 50, label: 'Base Unit' } ],
         identification: [ { position: 50, label: 'Base Unit' } ] }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_UnitOfMeasure', element: 'UnitOfMeasure' } }]
  UnitOfMeasure;

  @UI: { lineItem:       [ { position: 50, label: 'Currency' } ],
         identification: [ { position: 60, label: 'Currency' } ] }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_Currency', element: 'Currency' } }]
  CurrencyCode;

  /* Administrative Data - Usually grouped in a different facet or hidden from main list */
  @UI.identification: [ { position: 70, label: 'Created By' } ]
  CreatedBy;

  @UI.identification: [ { position: 80, label: 'Created At' } ]
  CreatedAt;

  @UI.identification: [ { position: 90, label: 'Last Changed By' } ]
  LastChangedBy;

  @UI.identification: [ { position: 100, label: 'Last Changed At' } ]
  LastChangedAt;

  @UI.identification: [ { position: 100, label: 'Local Last Changed At' } ]
  LocalLastChangedAt;
}