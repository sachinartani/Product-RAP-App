projection;
strict ( 2 );
//use draft;
//use side effects;

define behavior for zsac_c_product alias Product
{
  use create;
  use update;
  use delete;

//    use action Edit;
//    use action Resume;
//    use action Activate;
//    use action Discard;
//    use action Prepare;

  use action ResetMaterial;
  use action CreateProduct;

  use association _ProductText { create; }
  use association _ProductValuation { create; }
//    use association _ProductText { create; with draft; }
//    use association _ProductValuation { create; with draft; }

}

define behavior for zsac_c_product_text alias ProductText
{
  use update;
  use delete;

  use association _Product;
//    use association _Product { with draft; }
}

define behavior for zsac_c_product_valuation alias ProductValuation
{
  use update;
  use delete;

  use action AddStocks;

  use association _Product;
//    use association _Product { with draft; }
}